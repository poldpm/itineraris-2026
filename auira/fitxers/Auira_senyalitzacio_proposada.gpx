<?xml version="1.0" encoding="UTF-8"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd" version="1.1" creator="Revisió de camp 2026 · Itinerari de Sant Pere d'Aüira">
  <metadata>
    <name>Itinerari de Sant Pere d'Aüira · senyalització proposada</name>
    <desc>Plafó d'inici (dues opcions), banderoles noves a tots els punts conflictius i cartells existents que es mantenen. Revisió de camp 14/11/2026.</desc>
  </metadata>
  <wpt lat="42.22458" lon="2.167098">
    <name>Plafó d'inici · opció A: inici tradicional a l'església</name>
    <desc>Plafó d'inici de ruta a l'església, on comença tradicionalment l'itinerari (traçat de 2008).</desc>
    <sym>Information</sym>
    <type>Plafó proposat</type>
  </wpt>
  <wpt lat="42.222697" lon="2.165156">
    <name>Plafó d'inici · opció B: ruta circular des de l'aparcament</name>
    <desc>Plafó d'inici de ruta al cartell d'itinerari de l'aparcament, on porten les marques grogues actuals, per fer la ruta circular amb sortida i arribada al mateix punt.</desc>
    <sym>Information</sym>
    <type>Plafó proposat</type>
  </wpt>
  <wpt lat="42.224704" lon="2.166262">
    <name>Banderola · W04</name>
    <desc>Indicar Sant Pere d'Aüira cap a la dreta a la bifurcació del barri.</desc>
    <sym>Flag, Green</sym>
    <type>Banderola proposada</type>
  </wpt>
