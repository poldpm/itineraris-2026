  <metadata>
    <name>Itinerari de Sant Julià de Saltor · senyalització proposada</name>
    <desc>Plafó d'inici (cartellera existent), banderoles noves als punts confusos i cartells existents que es mantenen.</desc>
  </metadata>
  <wpt lat="42.234703" lon="2.168302">
    <name>Plafó d'inici · cartellera inicial existent (C01)</name>
    <desc>Plafó d'inici de ruta: la cartellera inicial existent (C01), a la sortida i arribada de la ruta circular. Es manté.</desc>
    <sym>Information</sym>
    <type>Plafó</type>
  </wpt>
  <wpt lat="42.23561" lon="2.17133">
    <name>Banderola · W01</name>
    <desc>Senyal vertical (banderola) a bifurcació on l'instint fa seguir per la pista ampla.</desc>
    <sym>Flag, Green</sym>
    <type>Banderola proposada</type>
  </wpt>
  <wpt lat="42.23802" lon="2.17459">
    <name>Banderola · W05</name>
    <desc>Senyal vertical (banderola) a bifurcacions sense línies grogues.</desc>
    <sym>Flag, Green</sym>
    <type>Banderola proposada</type>
  </wpt>
  <wpt lat="42.2427" lon="2.18143">
    <name>Banderola · W09</name>
    <desc>Senyal vertical (banderola) a una sola creu groga i molts camins possibles.</desc>
    <sym>Flag, Green</sym>
    <type>Banderola proposada</type>
  </wpt>
  <wpt lat="42.25459" lon="2.19505">
    <name>Banderola · W14</name>
    <desc>Senyal vertical (banderola) a espai molt obert amb una única línia groga amagada.</desc>
    <sym>Flag, Green</sym>
    <type>Banderola proposada</type>
  </wpt>
  <wpt lat="42.25455" lon="2.1925">
    <name>Banderola · W18</name>
    <desc>Senyal vertical (banderola) a falta un senyal vertical amb el destí.</desc>
    <sym>Flag, Green</sym>
    <type>Banderola proposada</type>
  </wpt>
  <wpt lat="42.25102" lon="2.18073">
    <name>Banderola · W19</name>
