    <type>Banderola proposada</type>
  </wpt>
  <wpt lat="42.25014" lon="2.17752">
    <name>Banderola · W20</name>
    <desc>Senyal vertical (banderola) a camí desdibuixat amb una pista a prop que confon.</desc>
